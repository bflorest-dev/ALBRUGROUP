{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noImplicitAny": false,

    /* Path aliases - FSD Español */
    "baseUrl": ".",
    "paths": {
      "@paginas/*": ["src/paginas/*"],
      "@widgets/*": ["src/widgets/*"],
      "@caracteristicas/*": ["src/caracteristicas/*"],
      "@entidades/*": ["src/entidades/*"],
      "@compartido/*": ["src/compartido/*"],
      "@app/*": ["src/app/*"],
      "@molecules": ["src/compartido/ui/moleculas/index"],
      "@molecules/*": ["src/compartido/ui/moleculas/*"],
      "@molecules/index": ["src/compartido/ui/moleculas/index"],
      "@molecules/DataTable": ["src/compartido/ui/moleculas/DataTable"],
      "@molecules/Modal": ["src/compartido/ui/moleculas/Modal"],
      "@molecules/StatCard": ["src/compartido/ui/moleculas/StatCard"],
      "@molecules/ApplicantForm": ["src/compartido/ui/moleculas/ApplicantForm"],
      "@molecules/Pagination": ["src/compartido/ui/moleculas/Pagination"],
      "@atoms": ["src/compartido/ui/atomos"],
      "@atoms/*": ["src/compartido/ui/atomos/*"],
      "@atoms/Badge/StatusBadge": ["src/compartido/ui/atomos/etiquetas"],
      "@types": ["src/compartido/tipos"],
      "@types/*": ["src/compartido/tipos/*"],
      "@components": ["src/compartido/ui"],
      "@components/*": ["src/compartido/ui/*"],
      "@components/utilities": ["src/components/utilities"],
      "@components/utilities/*": ["src/components/utilities/*"],
      "@compartido/tipos/lead.types": ["src/shared/types/lead.types"],
      "@compartido/tipos/advisor.types": ["src/shared/types/advisor.types"],
      "@compartido/tipos/tipification.types": ["src/shared/types/tipification.types"]
    },

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
